# Konfiguracja połączenia z bazą danych (w stacku Portainera użyj nazwy serwisu 'diet-med-DB')
DATABASE_URL=postgresql+psycopg://diet_user:diet_password@diet-med-DB:5432/diet_med

# Katalog generowania plików PDF
PDF_OUTPUT_DIR=/app/generated_pdfs

# Konfiguracja SMTP (opcjonalna, do wysyłki PDF mailem)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=twoj_email@gmail.com
SMTP_PASSWORD=twoje_haslo_aplikacji
SMTP_FROM=kontakt@diet-med.pl
SMTP_USE_TLS=True
